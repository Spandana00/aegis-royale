+#[cfg(test)]
+mod range_tests {
+    use super::*;
+    use super::super::{memory::Track, Params};
+    use crate::{nav, proto, world, Shared};
+    use std::sync::Arc;
+
+    fn fixture(guard: bool, own: WeaponKind, enemy: WeaponKind) -> (Brain, Obs, Track) {
+        let hello = proto::Hello::default();
+        let world = world::World::empty();
+        let shared = Arc::new(Shared { nav: nav::Nav::build(&world, &hello.config.mech), world });
+        let p = Params { gear_on: 1.0, gear_easy_range: 55.0, gear_lightning_guard: guard, ..Params::default() };
+        let brain = Brain::with_params(&hello, shared, p);
+        let mut obs = Obs::default();
+        obs.me.weapons = [Some(proto::WeaponObs { kind: WeaponKind::Gun, ..Default::default() }),
+                         Some(proto::WeaponObs { kind: own, ..Default::default() })];
+        let tr = Track { id: 2, kind: ActorKind::Mech, pos: [60.0, 0.0, 0.0], vel: [0.0; 3],
+            acc: [0.0; 3], aim: [0.0; 2], hp: 1400.0, max_hp: 1400.0, cubes: 0.0,
+            weapons: vec![WeaponKind::Gun, enemy], charging: false, charge_since: 0.0,
+            last_seen: 0.0, dmg_to_us: 0.0, last_dmg_t: -1000.0 };
+        (brain, obs, tr)
+    }
+
+    #[test]
+    fn preserves_lightning_spacing_after_easy_approach() {
+        let (b, o, tr) = fixture(true, WeaponKind::Laser, WeaponKind::Lightning);
+        assert!(b.gear_harmless(&tr, o.t, 60.0));
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 70.0);
+        assert_eq!(b.gear_range(&o, &tr, 85.0), 70.0);
+    }
+
+    #[test]
+    fn disabled_guard_reproduces_previous_approach() {
+        let (b, o, tr) = fixture(false, WeaponKind::Laser, WeaponKind::Lightning);
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 55.0);
+    }
+
+    #[test]
+    fn preserves_weak_gun_approach_and_own_lightning_rush() {
+        let (b, o, tr) = fixture(true, WeaponKind::Laser, WeaponKind::Gun);
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 55.0);
+        let (b, o, tr) = fixture(true, WeaponKind::Lightning, WeaponKind::Lightning);
+        assert_eq!(b.gear_range(&o, &tr, 30.0), 30.0);
+    }
+
+    #[test]
+    fn preserves_laser_duel_and_inactive_gear_ranges() {
+        let (mut b, o, mut tr) = fixture(true, WeaponKind::Laser, WeaponKind::Laser);
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 200.0);
+        tr.weapons = vec![WeaponKind::Gun, WeaponKind::Lightning];
+        Arc::make_mut(&mut b.p).gear_on = 0.0;
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 200.0);
+        Arc::make_mut(&mut b.p).gear_on = 1.0;
+        Arc::make_mut(&mut b.p).gear_easy_range = 0.0;
+        assert_eq!(b.gear_range(&o, &tr, 200.0), 200.0);
+    }
+}
